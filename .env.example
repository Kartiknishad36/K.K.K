# Telegram API credentials (get from https://my.telegram.org)
API_ID=12345678
API_HASH=your_api_hash_here

# Session name (can be anything)
SESSION_NAME=userbot

# Bot owner user ID (your own Telegram user ID)
OWNER_ID=123456789

# Optional: OpenAI API key for AI features
OPENAI_API_KEY=

# Database
DATABASE_PATH=data/userbot.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/userbot.log

# Feature toggles (true/false)
ENABLE_AFK=true
ENABLE_WELCOME=true
ENABLE_AUTODELETE=true
ENABLE_SCHEDULER=true
ENABLE_ANTISPAM=true
ENABLE_AI=false
ENABLE_TRANSLATOR=true
